<% content_for(:title) { "Market" } %>
<% content_for(:main_container_class) { "stock-market-container" } %>
<% content_for(:description) { "Browse and trade F1 drivers — buy shares, go long or short based on Elo rating performance." } %>
<div class="homepage-container stock-market-page"
     data-controller="stock-cart"
     data-action="keydown->stock-cart#close"
     data-stock-cart-portfolio-value="<%= @portfolio.id %>"
     data-stock-cart-race-value="<%= @next_race&.id %>"
     data-stock-cart-closes-at-value="<%= @portfolio.trading_closes_at(@next_race)&.iso8601 %>"
     data-stock-cart-open-value="<%= !!@can_trade %>"
     data-stock-cart-collateral-value="<%= FantasyStockPortfolio::COLLATERAL_RATIO %>"
     data-stock-cart-quote-url-value="<%= market_fantasy_stock_portfolio_path(@portfolio, format: :json) %>"
     data-stock-cart-cash-value="<%= @portfolio.available_cash %>"
     data-stock-cart-max-positions-value="<%= FantasyStockPortfolio::MAX_POSITIONS %>"
     data-stock-cart-used-positions-value="<%= @portfolio.position_count %>">

    <div class="fantasy-dashboard-header">
        <div class="fantasy-dashboard-title">
            <h2>Market</h2>
        </div>
        <div class="fantasy-header-actions">
            <%= link_to fantasy_overview_path(current_user.username), class: "fantasy-btn fantasy-btn-outline" do %>
                <i class="fa-solid fa-arrow-left"></i> Portfolio
            <% end %>
        </div>
    </div>

    <div class="fantasy-transfer-status <%= @can_trade ? 'open' : 'closed' %>">
        <i class="fa-solid fa-<%= @can_trade ? 'lock-open' : 'lock' %>"></i>
        <% if @can_trade %>
            <%= render "shared/deadline", closes_at: @portfolio.trading_closes_at(@next_race), label: "Market closes", note: (@next_race.starts_at ? "One minute before race start" : "Start time unavailable; midnight cutoff applies") %>
        <% else %>
            <span>Market closed <small><%= @next_race ? "— awaiting the next trading window" : "— no upcoming race scheduled" %></small></span>
        <% end %>
        <span class="fantasy-swaps-remaining">
            Credits: <strong><%= number_with_precision(@portfolio.available_cash, precision: 2, delimiter: ",", strip_insignificant_zeros: true) %></strong>
            &middot; Positions: <strong><%= @portfolio.position_count %>/<%= FantasyStockPortfolio::MAX_POSITIONS %></strong>
        </span>
    </div>

    <details class="market-intro">
        <summary>How to trade</summary>
        <p>Choose <strong>Long</strong> if you expect the price to rise, or <strong>Short</strong> if you expect it to fall. Edit quantities in your draft, then review and confirm. Adding a trade does not execute it.</p>
        <p>Trading closes one minute before race start. If the start time is unavailable, the midnight cutoff applies.</p>
    </details>

    <div class="fantasy-market-layout">
        <div class="fantasy-market-main">
            <div class="card card-flush">
                <div class="table-scroll-wrapper">
                    <table class="fantasy-market-table">
                        <thead>
                            <tr>
                                <th>Driver</th>
                                <th class="d-none d-md-table-cell">Form</th>
                                <th class="text-end">Price</th>
                                <th class="text-center d-none d-lg-table-cell" title="Net positions across all portfolios">Crowd</th>
                                <th class="text-end market-position-cell">
                                    <span class="th-label-full">Position</span>
                                    <span class="th-label-short">POS</span>
                                </th>
                                <% if @can_trade %>
                                    <th class="market-mobile-action">Trade</th>
                                    <th class="text-center market-trade-heading">Trade</th>
                                <% end %>
                            </tr>
                        </thead>
                        <tbody>
                            <% @drivers.each do |driver| %>
                                <% price = @prices_by_driver.fetch(driver.id) %>
                                <% constructor = @constructors_by_driver[driver.id] %>
                                <% color = constructor_color(constructor) %>
                                <% trends = @elo_trends[driver.id] || [] %>
                                <% holdings = @holdings_by_driver[driver.id] || [] %>
                                <% long_holding = holdings.find { |h| h.direction == "long" } %>
                                <% short_holding = holdings.find { |h| h.direction == "short" } %>
                                <% owned = long_holding || short_holding %>
                                <tr style="border-left: 3px solid <%= color %>"
                                    class="<%= 'fantasy-market-row--owned' if owned %>"
                                    data-stock-cart-target="card"
                                    data-driver-id="<%= driver.id %>"
                                    data-driver-name="<%= driver.fullname %>"
                                    data-driver-owned="<%= holdings.map(&:direction).to_json %>"
                                    data-driver-price="<%= price %>">
                                    <td>
                                        <div class="fantasy-market-driver-cell">
                                            <div class="fantasy-market-driver-info">
                                                <span class="fantasy-market-driver-name">
                                                    <%= flag_image(driver, size: 16) %>
                                                    <% short_name = "#{driver.forename[0]}. #{driver.surname}" %>
                                                    <%= link_to driver_path(driver), class: "fantasy-market-driver-link" do %>
                                                        <span class="fantasy-market-driver-name-full"><%= driver.fullname %></span>
                                                        <span class="fantasy-market-driver-name-short"><%= short_name %></span>
                                                    <% end %>
                                                </span>
                                                <span class="fantasy-market-team-name"><%= constructor&.name %></span>
                                                <% if owned %>
                                                    <span class="market-mobile-holding stock-direction-badge stock-<%= owned.direction %>"><%= owned.quantity %>× <%= owned.direction.capitalize %></span>
                                                <% end %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <% if trends.any? %>
                                            <div class="fantasy-elo-trend">
                                                <div class="fantasy-elo-trend-dots">
                                                    <% trends.reverse.each do |diff| %>
                                                        <span class="fantasy-elo-dot <%= diff > 0 ? 'up' : (diff < 0 ? 'down' : 'flat') %>" title="<%= diff > 0 ? '+' : '' %><%= diff %>">
                                                            <i class="fa-solid fa-caret-<%= diff >= 0 ? 'up' : 'down' %>"></i>
                                                        </span>
                                                    <% end %>
                                                </div>
                                                <% net = trends.sum %>
                                                <span class="fantasy-elo-trend-net <%= net > 0 ? 'up' : (net < 0 ? 'down' : 'flat') %>">
                                                    <%= net > 0 ? '+' : '' %><%= net %>
                                                </span>
                                            </div>
                                        <% else %>
                                            <span class="text-tertiary" style="font-size:11px">Rookie</span>
                                        <% end %>
                                    </td>
                                    <td class="text-end">
                                        <span class="fantasy-market-price-cell"><%= number_with_precision(price, precision: 2, strip_insignificant_zeros: true) %></span>
                                    </td>
                                    <td class="text-center d-none d-lg-table-cell">
                                        <% demand = @demand_by_driver[driver.id] || 0 %>
                                        <% crowd = short_interest_tag(demand) %>
                                        <span class="crowd-pill <%= crowd[:css] %>" title="Net demand: <%= demand %>">
                                            <% if crowd[:arrow] %>
                                                <i class="fa-solid fa-caret-<%= crowd[:arrow] %>"></i>
                                            <% end %>
                                            <%= demand %>
                                        </span>
                                    </td>
                                    <td class="text-end market-position-cell">
                                        <% if long_holding %>
                                            <span class="stock-direction-badge stock-long">
                                                <i class="fa-solid fa-arrow-trend-up"></i> <%= long_holding.quantity %>x
                                            </span>
                                        <% elsif short_holding %>
                                            <span class="stock-direction-badge stock-short">
                                                <i class="fa-solid fa-arrow-trend-down"></i> <%= short_holding.quantity %>x
                                            </span>
                                        <% else %>
                                            <span class="text-tertiary" style="font-size:11px">&mdash;</span>
                                        <% end %>
                                    </td>
                                    <% if @can_trade %>
                                        <td class="market-mobile-action">
                                            <button type="button" class="market-trade-toggle" aria-label="Trade <%= driver.fullname %>"
                                                    aria-expanded="false" aria-controls="trade-options-<%= driver.id %>"
                                                    data-action="click->stock-cart#toggleTrade">Trade</button>
                                        </td>
                                        <td class="text-center market-trade-cell" id="trade-options-<%= driver.id %>">
                                            <% can_afford = @portfolio.available_cash >= price * (long_holding ? 1 : FantasyStockPortfolio::COLLATERAL_RATIO) %>
                                            <% max_qty = can_afford ? [(@portfolio.available_cash / price).floor, 1].max : 0 %>
                                            <% can_open_new = !@portfolio.positions_full? || long_holding || short_holding %>
                                            <% if can_open_new && can_afford %>
                                                <% can_long = !short_holding %>
                                                <% can_short = !long_holding %>
                                                <%# All four slots (stepper, cost preview, Buy, Short) are
                                                    always rendered so columns align row-to-row. Unused
                                                    slots get the .slot-hidden class which uses
                                                    visibility:hidden — preserves layout, hides ink. %>
                                                <div class="stock-trade-actions"
                                                     data-controller="stock-qty"
                                                     data-stock-qty-price-value="<%= price %>"
                                                     data-stock-qty-max-value="<%= max_qty %>"
                                                     data-stock-qty-can-long-value="<%= can_long && @portfolio.available_cash >= price %>"
                                                     data-stock-qty-can-short-value="<%= can_short %>">
                                                    <div class="stock-qty-stepper <%= 'slot-hidden' if max_qty <= 1 %>">
                                                        <button type="button" class="stock-qty-btn"
                                                                aria-label="Decrease quantity for <%= driver.fullname %>"
                                                                data-stock-qty-target="minus"
                                                                data-action="click->stock-qty#decrement">&minus;</button>
                                                        <input type="number" min="1" max="<%= [max_qty, 1].max %>" value="1"
                                                               aria-label="Quantity for <%= driver.fullname %>"
                                                               class="stock-qty-input"
                                                               data-stock-qty-target="input" readonly>
                                                        <button type="button" class="stock-qty-btn"
                                                                aria-label="Increase quantity for <%= driver.fullname %>"
                                                                data-stock-qty-target="plus"
                                                                data-action="click->stock-qty#increment">+</button>
                                                    </div>
                                                    <span class="stock-cost-preview" data-stock-qty-target="cost">= <%= price.round(1) %></span>
                                                    <button type="button" class="stock-trade-btn stock-trade-buy <%= 'slot-hidden' unless can_long %>" title="Add long to cart"
                                                            data-trade-direction="long"
                                                            data-stock-qty-target="buyBtn"
                                                            data-action="click->stock-cart#addLong">
                                                        <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i> Long
                                                    </button>
                                                    <button type="button" class="stock-trade-btn stock-trade-short <%= 'slot-hidden' unless can_short %>" title="Add short to cart"
                                                            data-trade-direction="short"
                                                            data-stock-qty-target="shortBtn"
                                                            data-action="click->stock-cart#addShort">
                                                        <i class="fa-solid fa-arrow-trend-down" aria-hidden="true"></i> Short
                                                    </button>
                                                </div>
                                                <small class="market-trade-hint">Choose a direction; edit quantity in your draft.<% if can_long && @portfolio.available_cash < price %> Long needs <%= number_with_precision(price, precision: 2) %> credits.<% end %></small>
                                            <% elsif !can_afford %>
                                                <span class="fantasy-cart-reason">Insufficient funds</span>
                                            <% else %>
                                                <span class="fantasy-cart-reason">Max positions</span>
                                            <% end %>
                                        </td>
                                    <% end %>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%= render "cart" %>
    </div>

    <%= render "rules" %>
</div>
