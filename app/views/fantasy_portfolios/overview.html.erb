<% content_for(:title) { "#{@user.display_name}'s Fantasy Portfolio" } %>
<% content_for(:description) { "#{@user.display_name}'s fantasy F1 portfolio — stocks, picks, and performance on F1 Elo." } %>
<div class="homepage-container">
    <%# ═══════════════════ Header ═══════════════════ %>
    <% support = ConstructorSupport.current_for(@user, @season) %>
    <% if support %>
        <% sc = support.constructor %>
        <% team_color = constructor_color(sc) %>
    <% end %>
    <div class="fantasy-dashboard-header">
        <div class="fantasy-dashboard-identity">
            <div class="fantasy-dashboard-title">
                <h2 class="fantasy-dashboard-name<%= ' is-supported' if support %>"<%= support ? " style=\"color: #{team_color}\"".html_safe : '' %>>
                    <%= @user.display_name %>
                </h2>
                <div class="fantasy-dashboard-meta">
                    <span class="fantasy-season"><%= @season.year %> Fantasy</span>
                    <% if support %>
                        <%= link_to constructor_path(sc), class: "fantasy-team-chip", style: "--team-color: #{team_color}", title: sc.name do %>
                            <% if sc.logo_url.present? %>
                                <img src="<%= sc.logo_url %>" alt="" class="fantasy-team-chip-logo" onerror="this.style.display='none'">
                            <% end %>
                            <span class="fantasy-team-chip-name"><%= sc.name %></span>
                        <% end %>
                    <% end %>
                    <% if @is_owner %>
                        <%= form_with url: toggle_public_profile_path, method: :post, local: true, class: "fantasy-visibility-inline-form" do %>
                            <label class="fantasy-visibility-inline-label" title="<%= current_user.public_profile? ? 'Profile is public' : 'Profile is private' %>">
                                <input type="checkbox" <%= "checked" if current_user.public_profile? %> onchange="this.form.requestSubmit()">
                                <span><i class="fa-solid fa-<%= current_user.public_profile? ? 'globe' : 'lock' %>"></i></span>
                            </label>
                        <% end %>
                    <% end %>
                </div>
            </div>
        </div>
        <div class="fantasy-header-actions">
            <% if @is_owner && @stock_portfolio %>
                <%= link_to market_fantasy_stock_portfolio_path(@stock_portfolio), class: "fantasy-btn fantasy-btn-primary" do %>
                    <i class="fa-solid fa-store"></i> Market
                <% end %>
            <% end %>
            <%= link_to combined_leaderboard_path, class: "fantasy-btn fantasy-btn-outline" do %>
                <i class="fa-solid fa-ranking-star"></i> Leaderboard
            <% end %>
        </div>
    </div>

    <%# ═══════════════════ Pit Wall ═══════════════════ %>
    <%# One panel where the value hero, the account-summary chips and the
        weekend checklist used to be three stacked full-width bands. They all
        answer "where do I stand right now", so they belong in one block with a
        single focal point — the value — rather than three competing ones. %>
    <%
        cash            = @portfolio ? @portfolio.cash : 0
        collateral      = @stock_portfolio ? @stock_portfolio.total_collateral : 0
        cash_available  = cash - collateral
        stock_positions = @stock_portfolio ? @stock_portfolio.positions_value : 0
        stock_invested  = @stock_portfolio ? @stock_portfolio.total_invested : 0
        total_invested  = stock_invested + collateral
        total_value     = cash + stock_positions
        baseline        = @portfolio&.starting_capital || Fantasy::CreatePortfolio::STARTING_CAPITAL
        total_pl        = @portfolio ? @portfolio.total_return : 0
        total_pl_pct    = baseline > 0 ? (total_pl / baseline * 100) : 0
        pl_class        = total_pl >= 0 ? 'gain' : 'loss'
        last_snap_round = (@snapshots || []).last&.race&.round
        has_holdings    = @stock_portfolio && (@stock_holdings || []).any?
        cash_pct        = total_value > 0 ? (cash_available.to_f / total_value * 100).round : 0
        invested_pct    = (100 - cash_pct).clamp(0, 100)
    %>

    <%# Weekend checklist chips — state-driven; done ones dim and get a check,
        pending ones pop. H2H shows its +50 credit reward until claimed. %>
    <%
        chips = []
        if @is_owner && @portfolio
            checklist_race    = @next_race
            picks_done        = checklist_race && @race_picks.any? { |rp| rp.race_id == checklist_race.id && rp.picks.present? }
            picks_open        = checklist_race&.picks_open?
            h2h_done          = @h2h_done_for_race
            team_done         = support.present?
            first_shares_done = @stock_portfolio ? has_holdings : true

            if checklist_race
                chips << {
                    key: :picks, icon: "list", label: "Race picks",
                    done: picks_done,
                    locked: !picks_done && !picks_open,
                    path: (picks_open ? edit_race_picks_path : nil),
                    sub: (picks_done ? "Locked in" : (picks_open ? "Pick your top 10" : "Locked"))
                }
            end
            chips << {
                key: :h2h, icon: "versus", label: "Head-to-Head",
                done: h2h_done, path: head_to_head_path,
                reward: (h2h_done ? nil : 50),
                sub: (h2h_done ? "Bonus claimed" : "Play once per race")
            }
            unless team_done
                chips << {
                    key: :team, icon: "shield", label: "Pick a team",
                    done: false, path: "#team-picker",
                    sub: "Wear its colours"
                }
            end
            unless first_shares_done
                chips << {
                    key: :first_shares, icon: "store", label: "Buy first shares",
                    done: false, path: market_fantasy_stock_portfolio_path(@stock_portfolio),
                    sub: "Long or short a driver"
                }
            end
        end

        actionable  = chips.reject { |c| c[:locked] }
        done_count  = actionable.count { |c| c[:done] }
        total_count = actionable.size
        all_done    = total_count > 0 && done_count == total_count
    %>

    <section class="fantasy-pitwall <%= 'has-weekend' if chips.any? %>">
        <div class="fantasy-pitwall-value">
            <div class="fantasy-value-row-top">
                <span class="fantasy-value-label">Total Value</span>
                <% if @leaderboard_rank %>
                    <span class="fantasy-rank-chip" title="Leaderboard rank">
                        <%= ui_icon "podium", size: 12 %>
                        <span class="fantasy-rank-num">#<%= @leaderboard_rank %></span>
                        <% if @leaderboard_size && @leaderboard_size > 1 %>
                            <span class="fantasy-rank-of">of <%= @leaderboard_size %></span>
                        <% end %>
                        <% if @leaderboard_rank_delta && @leaderboard_rank_delta != 0 %>
                            <% up = @leaderboard_rank_delta > 0 %>
                            <span class="fantasy-rank-delta <%= up ? 'gain' : 'loss' %>">
                                <%= ui_icon(up ? "trend_up" : "trend_down", size: 11) %><%= @leaderboard_rank_delta.abs %>
                            </span>
                        <% end %>
                    </span>
                <% end %>
            </div>

            <span class="fantasy-value-number"><%= number_with_delimiter(total_value.round(0)) %></span>

            <div class="fantasy-value-pl-row">
                <span class="fantasy-value-pl <%= pl_class %>">
                    <%= total_pl >= 0 ? '+' : '' %><%= number_with_delimiter(total_pl.round(0)) %>
                    <span class="fantasy-value-pl-pct">(<%= total_pl_pct >= 0 ? '+' : '' %><%= total_pl_pct.round(1) %>%)</span>
                </span>
                <span class="fantasy-value-pl-sep">all-time</span>
                <% if @value_delta && last_snap_round %>
                    <span class="fantasy-value-race-delta <%= @value_delta >= 0 ? 'gain' : 'loss' %>">
                        <%= @value_delta >= 0 ? '+' : '' %><%= number_with_delimiter(@value_delta.round(0)) %>
                        <span class="fantasy-value-race-delta-label">R<%= last_snap_round %></span>
                    </span>
                <% end %>
            </div>

            <%# A number on its own says nothing about whether you're doing well.
                The gap to the player either side turns "#3 of 6" into a race. %>
            <% if @leaderboard_gap %>
                <p class="fantasy-value-standing">
                    <%= link_to combined_leaderboard_path, class: "fantasy-value-standing-link" do %>
                        <% if @leaderboard_gap_direction == :behind %>
                            <strong><%= number_with_delimiter(@leaderboard_gap) %></strong> behind P<%= @leaderboard_rank - 1 %>
                        <% else %>
                            <strong><%= number_with_delimiter(@leaderboard_gap) %></strong> clear of P2
                        <% end %>
                        <%= ui_icon "arrow_right", size: 12 %>
                    <% end %>
                </p>
            <% end %>

            <%# Allocation + the cash/invested split, previously three separate chips. %>
            <div class="fantasy-pitwall-meters">
                <% if has_holdings %>
                    <div class="fantasy-allocation-row">
                        <div class="fantasy-allocation-bar" title="<%= invested_pct %>% invested · <%= cash_pct %>% cash">
                            <div class="fantasy-allocation-bar-fill" style="width: <%= invested_pct %>%"></div>
                        </div>
                        <span class="fantasy-allocation-legend"><%= invested_pct %>% invested</span>
                    </div>
                <% end %>
                <dl class="fantasy-pitwall-figures">
                    <div>
                        <dt>Cash</dt>
                        <dd><%= number_with_delimiter(cash_available.round(0)) %></dd>
                    </div>
                    <div>
                        <dt>Invested</dt>
                        <dd><%= number_with_delimiter(total_invested.round(0)) %></dd>
                    </div>
                    <% if @long_count.to_i > 0 || @short_count.to_i > 0 %>
                        <div>
                            <dt>Positions</dt>
                            <dd class="fantasy-pitwall-positions">
                                <% if @long_count.to_i > 0 %>
                                    <span class="gain"><%= ui_icon "trend_up", size: 12 %><%= @long_count %></span>
                                <% end %>
                                <% if @short_count.to_i > 0 %>
                                    <span class="loss"><%= ui_icon "trend_down", size: 12 %><%= @short_count %></span>
                                <% end %>
                            </dd>
                        </div>
                    <% end %>
                    <% if collateral > 0 %>
                        <div>
                            <dt>Margin locked</dt>
                            <dd><%= ui_icon "lock", size: 12 %><%= number_with_delimiter(collateral.round(0)) %></dd>
                        </div>
                    <% end %>
                </dl>
                <% if @top_team_pct && @top_team_pct >= 40 %>
                    <p class="fantasy-pitwall-warning">
                        <%= ui_icon "warning", size: 13 %>
                        <span><strong><%= @top_team_pct %>%</strong> of your book is <%= @top_team_name %> — a bad weekend for them is a bad weekend for you.</span>
                    </p>
                <% end %>
            </div>
        </div>

        <% if chips.any? %>
            <aside class="fantasy-pitwall-weekend <%= 'is-complete' if all_done %>">
                <header class="fantasy-weekend-header">
                    <span class="fantasy-weekend-title">
                        <%= ui_icon "flag", size: 13 %>
                        <span class="fantasy-weekend-title-label">This weekend</span>
                    </span>
                    <% if total_count > 1 %>
                        <span class="fantasy-weekend-progress"><%= done_count %> / <%= total_count %></span>
                    <% end %>
                </header>

                <% if checklist_race %>
                    <div class="fantasy-weekend-race">
                        <span class="fantasy-weekend-race-name"><%= checklist_race.circuit.name %></span>
                        <% if checklist_race.starts_at && checklist_race.starts_at > Time.current %>
                            <span class="fantasy-weekend-lock" data-controller="countdown" data-countdown-target-value="<%= checklist_race.starts_at.iso8601 %>">
                                <%= ui_icon "lock", size: 11 %>
                                <span>Locks in</span>
                                <span data-countdown-target="display">—</span>
                            </span>
                        <% else %>
                            <span class="fantasy-weekend-lock is-locked">
                                <%= ui_icon "lock", size: 11 %><span>Locked</span>
                            </span>
                        <% end %>
                    </div>
                <% end %>

                <% if all_done %>
                    <p class="fantasy-weekend-done-text">
                        <%= ui_icon "check", size: 14 %>
                        You're all set. Enjoy the race.
                    </p>
                <% end %>

                <div class="fantasy-weekend-chips">
                    <% chips.each do |chip| %>
                        <% chip_classes = ["fantasy-weekend-chip"] %>
                        <% chip_classes << "is-done" if chip[:done] %>
                        <% chip_classes << "is-locked" if chip[:locked] %>
                        <% tag = (chip[:path] && !chip[:locked]) ? :a : :div %>
                        <%= content_tag tag, class: chip_classes.join(" "), href: (tag == :a ? chip[:path] : nil) do %>
                            <span class="fantasy-weekend-chip-icon">
                                <% if chip[:done] %>
                                    <%= ui_icon "check", size: 14 %>
                                <% elsif chip[:locked] %>
                                    <%= ui_icon "lock", size: 13 %>
                                <% else %>
                                    <%= ui_icon chip[:icon], size: 14 %>
                                <% end %>
                            </span>
                            <span class="fantasy-weekend-chip-body">
                                <span class="fantasy-weekend-chip-label"><%= chip[:label] %></span>
                                <% if chip[:sub] %>
                                    <span class="fantasy-weekend-chip-sub"><%= chip[:sub] %></span>
                                <% end %>
                            </span>
                            <% if chip[:reward] %>
                                <span class="fantasy-weekend-chip-reward">+<%= chip[:reward] %></span>
                            <% elsif !chip[:done] && !chip[:locked] && chip[:path] %>
                                <span class="fantasy-weekend-chip-arrow"><%= ui_icon "arrow_right", size: 13 %></span>
                            <% end %>
                        <% end %>
                    <% end %>
                </div>

                <%# The checklist is the one place a player is already thinking
                    "what am I meant to do this weekend" — so it's where the
                    rules belong, rather than only in a nav dropdown. %>
                <%= link_to fantasy_guide_path, class: "fantasy-weekend-guide" do %>
                    <%= ui_icon "book", size: 13 %>
                    <span>How scoring, dividends and shorts work</span>
                    <%= ui_icon "arrow_right", size: 12 %>
                <% end %>
            </aside>
        <% end %>
    </section>


    <%# ═══════════════════ Chart ═══════════════════ %>
    <%
        season_rounds = @season.races.order(:round).pluck(:round)
        roster_snaps  = (@snapshots || []).index_by { |s| s.race.round }
        stock_snaps   = (@stock_snapshots || []).index_by { |s| s.race.round }
        chart_color   = support ? team_color : "#e10600"
        chart_rgb     = chart_color ? hex_to_rgb(chart_color) : "225, 6, 0"

        # Only include rounds that have at least one snapshot
        snapped_rounds = season_rounds.select { |r| roster_snaps[r] || stock_snaps[r] }

        chart_start = baseline
        chart_labels = ["Start"] + snapped_rounds.map { |r| "R#{r}" }
        chart_total = [chart_start.round(0)] + snapped_rounds.map do |r|
            rs = roster_snaps[r]
            ss = stock_snaps[r]
            (rs ? rs.value : (ss&.value || 0)).round(0)
        end

        chart_series = [
            {
                name: "Total Value",
                type: "line",
                data: chart_total,
                smooth: true,
                connectNulls: true,
                showSymbol: true,
                symbolSize: 6,
                lineStyle: { color: chart_color, width: 3 },
                itemStyle: { color: chart_color },
                areaStyle: { color: { type: "linear", x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: "rgba(#{chart_rgb}, 0.15)" }, { offset: 1, color: "rgba(#{chart_rgb}, 0)" }] } },
                markLine: {
                    symbol: "none",
                    silent: true,
                    lineStyle: { color: "rgba(255,255,255,0.25)", type: "dashed", width: 1 },
                    label: {
                        show: true,
                        position: "insideStartTop",
                        formatter: "Start",
                        color: "rgba(255,255,255,0.45)",
                        fontSize: 10,
                        padding: [0, 0, 2, 4]
                    },
                    data: [{ yAxis: chart_start }]
                }
            }
        ]

        tooltip_formatter = RailsCharts::Javascript.new(<<~JS)
          function(params) {
            if (!params || params.length === 0) return '';
            var total = null, start = #{chart_start};
            params.forEach(function(p) {
              if (p.value == null) return;
              if (p.seriesName === 'Total Value') total = p.value;
            });
            if (total == null) return '';
            var pl = total - start;
            var sign = pl >= 0 ? '+' : '';
            var plColor = pl >= 0 ? '#4ade80' : '#f87171';
            var html = '<div style="font-weight:600;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.15);padding-bottom:4px;font-size:13px">' + params[0].axisValueLabel + '</div>';
            html += '<div style="display:flex;justify-content:space-between;gap:16px;line-height:1.7">';
            html += '<span style="color:#aaa">Total</span><span style="font-weight:700;font-family:monospace">' + total.toLocaleString() + '</span></div>';
            html += '<div style="display:flex;justify-content:space-between;gap:16px;line-height:1.7">';
            html += '<span style="color:#aaa">P&L</span><span style="font-weight:700;font-family:monospace;color:' + plColor + '">' + sign + pl.toLocaleString() + '</span></div>';
            return html;
          }
        JS

        # Tight dynamic bounds — include the start reference so it always shows,
        # add a small margin (at least 50 units) so flat or near-flat lines still
        # have breathing room, then round to a clean step for legible axis labels.
        all_vals = chart_total.compact
        if all_vals.any?
            effective_min = [all_vals.min, chart_start].min
            effective_max = [all_vals.max, chart_start].max
            range         = effective_max - effective_min
            margin        = [range * 0.15, 50].max
            step          = range > 2000 ? 500 : (range > 500 ? 100 : 50)
            chart_min     = ((effective_min - margin) / step).floor * step
            chart_max     = ((effective_max + margin) / step).ceil * step
        else
            chart_min = 0
            chart_max = nil
        end
    %>
    <div class="table-header"><h3>Portfolio Value</h3></div>
    <div class="card card-flush fantasy-chart-card">
        <% chart_options = {
            tooltip: {
                trigger: "axis",
                appendToBody: true,
                backgroundColor: "rgba(20, 20, 30, 0.95)",
                borderColor: "rgba(255, 255, 255, 0.12)",
                borderWidth: 1,
                textStyle: { color: "#e0e0e0", fontSize: 13 },
                confine: true,
                formatter: tooltip_formatter
            },
            grid: { left: 10, right: 16, top: 20, bottom: 10, containLabel: true },
            backgroundColor: "transparent",
            xAxis: {
                type: "category",
                data: chart_labels,
                axisLabel: { color: "#666", fontSize: 10 },
                axisLine: { lineStyle: { color: "#333" } }
            },
            yAxis: {
                type: "value",
                min: chart_min,
                max: chart_max,
                axisLabel: { color: "#666" },
                splitLine: { lineStyle: { color: "rgba(255,255,255,0.04)" } }
            },
            series: chart_series
        } %>
        <%= custom_chart(chart_options.merge(width: "100%", height: "200px")) %>
    </div>

    <%# ═══════════════════ HOLDINGS ═══════════════════ %>

    <% if @portfolio %>
        <div class="table-header">
            <h3>Holdings</h3>
            <% if has_holdings %>
                <span class="table-header-sub"><%= @stock_holdings.size %> position<%= @stock_holdings.size == 1 ? '' : 's' %></span>
            <% end %>
        </div>

        <% if has_holdings %>
            <div class="fantasy-roster-grid">
                <% @stock_holdings.each do |holding| %>
                    <%= render "fantasy_portfolios/holding_card",
                        holding: holding,
                        constructors_by_driver: @stock_constructors,
                        show_sell: @is_owner,
                        can_trade: @stock_can_trade,
                        stock_portfolio: @stock_portfolio %>
                <% end %>
                <% if @is_owner && !@stock_portfolio.positions_full? %>
                    <%= link_to market_fantasy_stock_portfolio_path(@stock_portfolio), class: "driver-card-empty" do %>
                        <div class="driver-card-empty-content">
                            <i class="fa-solid fa-plus"></i>
                            <span>Buy Shares</span>
                        </div>
                    <% end %>
                <% end %>
            </div>

        <% else %>
            <div class="card empty-state">
                <i class="fa-solid fa-chart-line"></i>
                <h3>No positions yet</h3>
                <% if @is_owner %>
                    <p>You have <strong><%= number_with_delimiter(@portfolio.cash.round(0)) %></strong> to start trading.</p>
                    <% if @stock_portfolio %>
                        <%= link_to market_fantasy_stock_portfolio_path(@stock_portfolio), class: "fantasy-btn fantasy-btn-primary" do %>
                            <i class="fa-solid fa-store"></i> Explore Drivers
                        <% end %>
                    <% end %>
                <% end %>
            </div>
        <% end %>
    <% end %>

    <%# ═══════════════════ Season log ═══════════════════ %>
    <%# Picks, cards, activity and achievements were four more full-width bands
        below the fold, each with the same visual weight as the portfolio itself.
        They're all "what happened already", so they share one panel. Tabs keep
        every one of them named and one click away rather than hiding them — the
        labels are the discovery surface. %>
    <%
        picks_count       = @race_picks.count { |rp| rp.placed_drivers.any? }
        cards_count       = @driver_cards_total.to_i
        activity_count    = @is_owner ? (@activity_entries || []).size : 0
        all_definitions   = {}
        FantasyAchievement::DEFINITIONS.each { |k, v| all_definitions[k] = v }
        FantasyStockAchievement::DEFINITIONS.each { |k, v| all_definitions[k] = v }
        all_earned        = [*(@achievements || []), *(@stock_achievements || [])]
        earned_keys       = all_earned.map(&:key).to_set
        tier_order        = { "gold" => 0, "silver" => 1, "bronze" => 2 }
        earned_definitions = all_definitions.select { |k, _| earned_keys.include?(k.to_s) }
                                            .sort_by { |_, d| tier_order[d[:tier]] || 3 }
        locked_definitions = all_definitions.reject { |k, _| earned_keys.include?(k.to_s) }
                                            .sort_by { |_, d| tier_order[d[:tier]] || 3 }

        log_tabs = []
        log_tabs << { key: "picks",   label: "Race Picks",   count: (picks_count if picks_count > 0) } if @race_picks.any? || (@is_owner && @season.next_race)
        log_tabs << { key: "cards",   label: "Driver Cards", count: (cards_count if cards_count > 0) } if cards_count > 0
        log_tabs << { key: "activity", label: "Activity",    count: nil } if @is_owner && (@activity_entries || []).any?
        log_tabs << { key: "achievements", label: "Achievements", count: "#{all_earned.size}/#{all_definitions.size}" }
        default_log_tab = log_tabs.first&.dig(:key)
    %>

    <% if log_tabs.any? %>
        <section class="fantasy-log" data-controller="tab-table">
            <div class="table-header table-header-tabs fantasy-log-tabs">
                <% log_tabs.each do |t| %>
                    <h3 class="table-tab <%= 'active' if t[:key] == default_log_tab %>"
                        data-tab="<%= t[:key] %>" data-tab-table-target="tab"
                        data-action="click->tab-table#switch">
                        <%= t[:label] %><% if t[:count] %><span class="table-tab-count"><%= t[:count] %></span><% end %>
                    </h3>
                <% end %>
            </div>

            <div class="fantasy-log-panel" data-tab="picks" data-tab-table-target="panel"
                 style="<%= 'display:none' unless default_log_tab == 'picks' %>">
    <%# ═══════════════════ Race Picks ═══════════════════ %>
    <% if @race_picks.any? || (@is_owner && @season.next_race) %>
        <%
            next_race = @season.next_race
            upcoming_pick = @race_picks.find { |rp| next_race && rp.race_id == next_race.id }
            past_picks = @race_picks.reject { |rp| next_race && rp.race_id == next_race.id }
            all_pick_driver_ids = @race_picks.flat_map { |rp| (rp.picks || []).map { |p| p["driver_id"] } }.uniq
            picks_drivers_by_id = Driver.where(id: all_pick_driver_ids).index_by(&:id) if all_pick_driver_ids.any?
            picks_drivers_by_id ||= {}
            picks_sd_index = SeasonDriver.where(season: @season, driver_id: all_pick_driver_ids).includes(:constructor).index_by(&:driver_id) if all_pick_driver_ids.any?
            picks_sd_index ||= {}
        %>
        <%
            best_pick_entry = @pick_summaries.max_by { |_, s| s[:total].to_i }
            best_pick = best_pick_entry && best_pick_entry[1][:total].to_i > 0 ? @race_picks.find { |rp| rp.id == best_pick_entry[0] } : nil
            best_pick_summary = best_pick && best_pick_entry[1]
        %>
        <div class="fantasy-log-toolbar">
            <% if best_pick %>
                <span class="fantasy-best-pick" title="Your best-scoring pick this season">
                    <i class="fa-solid fa-trophy"></i>
                    <span class="fantasy-best-pick-label">Best</span>
                    <%= link_to race_pick_results_path(@user.username, best_pick.race_id), class: "fantasy-best-pick-link" do %>
                        <span class="fantasy-best-pick-race">R<%= best_pick.race.round %></span>
                        <span class="fantasy-best-pick-stat"><%= best_pick_summary[:total] %> pts</span>
                        <span class="fantasy-best-pick-stat">·</span>
                        <span class="fantasy-best-pick-stat"><%= best_pick_summary[:exact] %> exact</span>
                    <% end %>
                </span>
            <% end %>
            <% if @is_owner && next_race %>
                <span class="table-header-sub">
                    <% if !next_race.picks_open? %>
                        <span class="picks-compact-edit picks-compact-locked"><i class="fa-solid fa-lock"></i> Locked</span>
                    <% else %>
                        <%= link_to edit_race_picks_path, class: "picks-compact-edit" do %>
                            <% if upcoming_pick&.picks&.any? %>
                                <i class="fa-solid fa-pen"></i> Edit
                            <% else %>
                                Make Picks <i class="fa-solid fa-arrow-right"></i>
                            <% end %>
                        <% end %>
                    <% end %>
                </span>
            <% end %>
        </div>

        <%# ── Upcoming race pick ── %>
        <% if upcoming_pick&.picks&.any? %>
            <% all_placed = upcoming_pick.placed_drivers %>
            <div class="picks-compact">
                <div class="picks-compact-header">
                    <span class="picks-compact-title">
                        <i class="fa-solid fa-circle" style="font-size:6px; color: #4ade80"></i>
                        <%= next_race.circuit.name %> · R<%= next_race.round %>
                    </span>
                </div>
                <div class="picks-compact-grid">
                    <% all_placed.first(10).each do |pick| %>
                        <% driver = picks_drivers_by_id[pick["driver_id"]] %>
                        <% next unless driver %>
                        <% constructor = picks_sd_index[driver.id]&.constructor %>
                        <% color = constructor_color(constructor) %>
                        <span class="picks-compact-pill" style="--constructor-color: <%= color %>" title="<%= driver.fullname %>">
                            <span class="picks-compact-pos place-<%= pick["position"] <= 3 ? pick["position"] : '' %>"><%= pick["position"] %></span>
                            <span class="picks-compact-name"><%= driver.surname %></span>
                        </span>
                    <% end %>
                    <% if all_placed.size > 10 %>
                        <span class="picks-compact-more">+<%= all_placed.size - 10 %></span>
                    <% end %>
                </div>
            </div>
        <% elsif @is_owner && next_race %>
            <div class="picks-compact picks-compact-empty">
                <span class="picks-compact-title">
                    <i class="fa-solid fa-circle" style="font-size:6px; color: #4ade80"></i>
                    <%= next_race.circuit.name %> · R<%= next_race.round %>
                </span>
                <% if next_race.picks_open? %>
                    <%= link_to edit_race_picks_path, class: "picks-compact-edit" do %>
                        Make Picks <i class="fa-solid fa-arrow-right"></i>
                    <% end %>
                <% else %>
                    <span class="picks-compact-edit picks-compact-locked"><i class="fa-solid fa-lock"></i> Picks closed</span>
                <% end %>
            </div>
        <% end %>

        <%# ── Past race picks (summary rows → scorecard) ── %>
        <% past_picks.each do |race_pick| %>
            <% next if race_pick.placed_drivers.empty? %>
            <% summary = @pick_summaries[race_pick.id] %>
            <% if summary %>
                <%= link_to race_pick_results_path(@user.username, race_pick.race_id), class: "picks-result-row" do %>
                    <span class="picks-result-race"><%= race_pick.race.circuit.name %> · R<%= race_pick.race.round %></span>
                    <span class="picks-result-meta">
                        <span class="picks-result-pts"><%= summary[:total] %> pts</span>
                        <span class="picks-result-exact"><%= summary[:exact] %> exact</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                <% end %>
            <% else %>
                <div class="picks-result-row picks-result-row-static">
                    <span class="picks-result-race"><%= race_pick.race.circuit.name %> · R<%= race_pick.race.round %></span>
                    <span class="picks-result-meta picks-result-pending">Awaiting results</span>
                </div>
            <% end %>
        <% end %>
    <% end %>

            </div>

            <div class="fantasy-log-panel" data-tab="cards" data-tab-table-target="panel"
                 style="<%= 'display:none' unless default_log_tab == 'cards' %>">
    <%# ═══════════════════ Driver Cards ═══════════════════ %>
    <% if @driver_cards_total.to_i > 0 %>
        <div class="fantasy-log-toolbar">
            <span class="fantasy-log-toolbar-note"><%= @driver_cards_total %> earned this season</span>
            <%= link_to driver_cards_path(username: @user.username), class: "picks-compact-edit" do %>
                View collection <%= ui_icon "arrow_right", size: 13 %>
            <% end %>
        </div>
        <div class="dc-collection dc-portfolio-strip">
            <div class="dc-portfolio-strip-tiers">
                <% %w[bronze silver gold platinum legendary].each do |t| %>
                    <% n = @driver_cards_tier_counts[t].to_i %>
                    <% next if n.zero? %>
                    <span class="dc-portfolio-strip-tier dc-portfolio-strip-tier-<%= t %>">
                        <%= n %> <%= t.first(2).upcase %>
                    </span>
                <% end %>
            </div>
            <div class="dc-grid dc-portfolio-strip-grid">
                <% @driver_cards_decks.each do |deck_cards| %>
                    <%= render "driver_cards/deck", cards: deck_cards, is_owner: @is_owner %>
                <% end %>
            </div>
        </div>
    <% end %>

            </div>

            <div class="fantasy-log-panel" data-tab="activity" data-tab-table-target="panel"
                 style="<%= 'display:none' unless default_log_tab == 'activity' %>">
    <%# ═══════════════════ Activity ═══════════════════ %>
    <% if @is_owner && @activity_entries&.any? %>
        <%# show_header: false — the tab label is the heading here. %>
        <%= render "fantasy_portfolios/activity_feed",
                   entries: @activity_entries,
                   round_amount: true,
                   show_header: false,
                   view_all_path: fantasy_activity_path(username: @user.username) %>
        <div class="fantasy-log-toolbar fantasy-log-toolbar-end">
            <%= link_to fantasy_activity_path(username: @user.username), class: "picks-compact-edit" do %>
                View all activity <%= ui_icon "arrow_right", size: 13 %>
            <% end %>
        </div>
    <% end %>

            </div>

            <div class="fantasy-log-panel" data-tab="achievements" data-tab-table-target="panel"
                 style="<%= 'display:none' unless default_log_tab == 'achievements' %>">
    <%# ═══════════════════ Achievements (combined) ═══════════════════ %>
    <% if earned_definitions.any? %>
        <div class="fantasy-achievements-grid">
            <% earned_definitions.each do |key, defn| %>
                <div class="fantasy-achievement-card earned tier-<%= defn[:tier] %>">
                    <div class="fantasy-achievement-icon">
                        <%= ui_icon defn[:glyph] || "star", size: 17 %>
                    </div>
                    <div class="fantasy-achievement-info">
                        <strong><%= defn[:name] %></strong>
                        <span><%= defn[:description] %></span>
                    </div>
                    <span class="fantasy-achievement-tier tier-<%= defn[:tier] %>"><%= defn[:tier] %></span>
                </div>
            <% end %>
        </div>
    <% else %>
        <div class="fantasy-achievements-empty">No achievements earned yet.</div>
    <% end %>
    <% if locked_definitions.any? %>
        <details class="fantasy-achievements-locked">
            <summary>
                <span>Show <%= locked_definitions.size %> locked</span>
                <i class="fa-solid fa-chevron-down"></i>
            </summary>
            <div class="fantasy-achievements-grid">
                <% locked_definitions.each do |key, defn| %>
                    <div class="fantasy-achievement-card locked">
                        <div class="fantasy-achievement-icon">
                            <%= ui_icon defn[:glyph] || "star", size: 17 %>
                        </div>
                        <div class="fantasy-achievement-info">
                            <strong><%= defn[:name] %></strong>
                            <span><%= defn[:description] %></span>
                        </div>
                    </div>
                <% end %>
            </div>
        </details>
    <% end %>

            </div>

        </section>
    <% end %>

    <%# ═══════════════════ Predictions ═══════════════════ %>
    <% if @predictions.any? %>
        <div class="table-header"><h3>Race Previews</h3></div>
        <div class="fantasy-nav-cards">
            <% @predictions.each do |prediction| %>
                <%= link_to preview_race_path(prediction.race, username: @user.username), class: "fantasy-nav-card" do %>
                    <div class="fantasy-nav-card-header">
                        <i class="fa-solid fa-robot"></i>
                        <h3><%= prediction.race.circuit.name %></h3>
                        <span class="fantasy-nav-stat" style="margin-left:auto">R<%= prediction.race.round %></span>
                    </div>
                    <div class="fantasy-nav-card-body">
                        <span class="fantasy-nav-stat"><%= prediction.analysis.truncate(120) %></span>
                    </div>
                <% end %>
            <% end %>
        </div>
    <% end %>

    <%# Team picker (only when no team chosen, owner only) %>
    <% if !support && @is_owner %>
        <div class="fantasy-pick-team-row" id="team-picker">
            <span class="fantasy-pick-team-label"><i class="fa-solid fa-shield-halved"></i> Pick a team</span>
            <div class="fantasy-allegiance-options-inline">
                <% Constructor.where(active: true).order(:name).each do |c| %>
                    <%= link_to support_constructor_path(c), data: { turbo_method: :post, turbo_confirm: "Support #{c.name}? Locked until mid-season." }, class: "fantasy-allegiance-badge-sm", title: c.name do %>
                        <% if c.logo_url.present? %>
                            <img src="<%= c.logo_url %>" alt="<%= c.name %>" class="constructor-logo-xs" onerror="this.style.display='none'">
                        <% end %>
                    <% end %>
                <% end %>
            </div>
        </div>
    <% end %>
</div>
