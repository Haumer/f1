<% content_for(:title) { "Fantasy Leaderboard" } %>
<% content_for(:description) { "Fantasy F1 leaderboard — portfolio rankings for the #{@season.year} season on F1 Elo." } %>
<div class="homepage-container">
    <%= page_hero "Leaderboard",
                  label: "#{@season.year} Season",
                  meta: "Ranked by net value \u2014 the profit or loss each player has generated from the same starting capital.",
                  bar: true do %>
        <% if current_user %>
            <%= link_to fantasy_overview_path(current_user.username), class: "fantasy-btn fantasy-btn-outline" do %>
                <%= ui_icon "briefcase" %> My Portfolio
            <% end %>
        <% else %>
            <%= link_to new_user_session_path, class: "fantasy-btn fantasy-btn-primary" do %>
                <%= ui_icon "flag" %> Join the league
            <% end %>
        <% end %>
        <%= link_to fantasy_guide_path, class: "fantasy-btn fantasy-btn-outline" do %>
            <%= ui_icon "book" %> How it works
        <% end %>
    <% end %>

    <% if @entries.any? %>
        <div class="card card-flush">
            <div class="table-scroll-wrapper">
                <table class="fantasy-leaderboard-table">
                    <thead>
                        <tr>
                            <th class="text-center">#</th>
                            <th>Player</th>
                            <th class="text-center d-none d-md-table-cell">Season</th>
                            <th class="text-end">Net Value</th>
                            <th class="text-end d-none d-sm-table-cell">Last Race</th>
                            <th class="text-end d-none d-lg-table-cell">Behind</th>
                            <th class="text-end d-none d-md-table-cell">Total Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% @entries.each_with_index do |entry, idx| %>
                            <% portfolio = entry[:portfolio] %>
                            <% user = portfolio.user %>
                            <% is_me = current_user && user.id == current_user.id %>
                            <% support = @supports_by_user[user.id] %>
                            <% color = support ? constructor_color(support.constructor) : nil %>
                            <% last_race = @deltas[portfolio.id] || 0 %>
                            <% net = entry[:net] %>
                            <tr class="<%= 'fantasy-leaderboard-me' if is_me %> <%= "podium-p#{idx + 1}" if idx < 3 %>">
                                <td class="text-center position-cell"><%= idx + 1 %></td>
                                <td>
                                    <span class="leaderboard-player">
                                        <% if support&.constructor&.logo_url.present? %>
                                            <img src="<%= support.constructor.logo_url %>" alt="" class="constructor-logo-xs leaderboard-team-logo" onerror="this.parentElement.querySelector('.leaderboard-team-placeholder').style.display='inline-flex'; this.remove();">
                                        <% end %>
                                        <span class="leaderboard-team-placeholder" title="No team chosen"<%= ' style="display:none"'.html_safe if support&.constructor&.logo_url.present? %>><%= ui_icon "shield", size: 12 %></span>
                                        <% if user.public_profile? %>
                                            <%= link_to fantasy_overview_path(user.username), class: "leaderboard-player-name", style: color ? "color: #{color}" : nil do %><strong><%= user.display_name %></strong><% end %>
                                        <% else %>
                                            <strong class="leaderboard-player-name" <% if color %>style="color: <%= color %>"<% end %>><%= user.display_name %></strong>
                                        <% end %>
                                        <% if is_me %><span class="fantasy-you-badge">You</span><% end %>
                                    </span>
                                </td>
                                <%# Season shape — who's climbing, who's sliding. A rank
                                    column alone can't show that. %>
                                <td class="text-center d-none d-md-table-cell fantasy-leaderboard-spark">
                                    <%= sparkline(@sparklines[portfolio.id], baseline: Fantasy::CreatePortfolio::STARTING_CAPITAL) %>
                                </td>
                                <td class="text-end fantasy-leaderboard-value">
                                    <span class="<%= net >= 0 ? 'text-green' : 'text-red' %>">
                                        <%= net >= 0 ? '+' : '' %><%= number_with_delimiter(net.round(0)) %>
                                    </span>
                                    <% if last_race != 0 %>
                                        <span class="leaderboard-last-race-inline d-sm-none <%= last_race >= 0 ? 'text-green' : 'text-red' %>">
                                            <%= last_race >= 0 ? '+' : '' %><%= number_with_delimiter(last_race.round(0)) %> last race
                                        </span>
                                    <% end %>
                                </td>
                                <td class="text-end d-none d-sm-table-cell">
                                    <% if last_race != 0 %>
                                        <span class="<%= last_race >= 0 ? 'text-green' : 'text-red' %>">
                                            <%= last_race >= 0 ? '+' : '' %><%= number_with_delimiter(last_race.round(0)) %>
                                        </span>
                                    <% else %>
                                        <span class="text-secondary">&mdash;</span>
                                    <% end %>
                                </td>
                                <td class="text-end d-none d-lg-table-cell fantasy-leaderboard-gap">
                                    <%# Round both sides before subtracting, so the gap
                                        agrees with the Total Value column the reader can
                                        see. Subtracting raw values then rounding printed
                                        "−684" next to totals that differ by 683. %>
                                    <% gap = @leader_value ? (@leader_value.round(0) - entry[:value].round(0)) : nil %>
                                    <% if gap.nil? || gap <= 0 %>
                                        <span class="fantasy-leaderboard-leader">Leader</span>
                                    <% else %>
                                        &minus;<%= number_with_delimiter(gap.round(0)) %>
                                    <% end %>
                                </td>
                                <td class="text-end d-none d-md-table-cell"><%= number_with_delimiter(entry[:value].round(0)) %></td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </div>
    <% else %>
        <div class="card empty-state">
            <%= ui_icon "podium", size: 30 %>
            <h3>No portfolios yet</h3>
            <p>Be the first to <%= link_to "create a fantasy portfolio", new_fantasy_portfolio_path %>.</p>
        </div>
    <% end %>
</div>
