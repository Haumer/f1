<div class="password-field" data-controller="password-visibility">
    <%= form.password_field attribute,
          autocomplete: autocomplete,
          autofocus: local_assigns.fetch(:autofocus, false),
          placeholder: placeholder,
          class: "devise-input",
          data: { password_visibility_target: "input" } %>
    <button type="button" class="password-toggle" hidden
            aria-label="Show <%= attribute.to_s.humanize.downcase %>" aria-pressed="false"
            aria-controls="<%= form.field_id(attribute) %>"
            data-password-visibility-target="toggle" data-action="password-visibility#toggle">Show</button>
</div>
