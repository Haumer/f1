<% content_for(:title) { "How Fantasy Works" } %>
<% content_for(:description) { "How Fantasy F1 works on F1 Elo — trade driver shares, predict the finishing order, collect driver cards, and rank the grid head-to-head." } %>
<div class="homepage-container">
    <%= page_hero "How Fantasy Works",
                  label: "The Guide",
                  meta: "Five ways to play, one leaderboard. Everything runs off the same Elo ratings that power the rest of the site — no made-up prices, no fantasy points table.",
                  compact: false %>

    <%# ═══════════════════ The five pillars ═══════════════════ %>
    <%# The guide used to describe the stock market and nothing else, so picks,
        cards, head-to-head and allegiance existed with no explanation anywhere.
        This grid is the map: what each one is, how it pays, and a way in. %>
    <%
        signed_in_portfolio = user_signed_in? ? current_user.fantasy_portfolio_for(current_season) : nil
        signed_in_stocks    = user_signed_in? ? current_user.fantasy_stock_portfolio_for(current_season) : nil

        pillars = [
            {
                icon: "store", anchor: "market", title: "The Driver Market",
                blurb: "Buy shares in drivers whose Elo you think is going up — or short the ones you think are going down.",
                pays: "Price moves + dividends",
                path: (signed_in_stocks ? market_fantasy_stock_portfolio_path(signed_in_stocks) : nil),
                cta: "Open market"
            },
            {
                icon: "list", anchor: "picks", title: "Race Picks",
                blurb: "Call the top 10 before the lights go out. The closer you are, the more you score.",
                pays: "Up to #{Fantasy::ScoreRacePicks::POINTS_BY_DISTANCE[0]} pts per position",
                path: edit_race_picks_path,
                cta: "Make your picks"
            },
            {
                icon: "card", anchor: "cards", title: "Driver Cards",
                blurb: "Every exactly-right pick mints a collectible card. Rarer calls mint rarer cards.",
                pays: "5 tiers, bronze to legendary",
                path: (user_signed_in? ? driver_cards_path(username: current_user.username) : nil),
                cta: "Your collection"
            },
            {
                icon: "versus", anchor: "h2h", title: "Head-to-Head",
                blurb: "Two drivers, one question: who do you rate higher? Your answers build a crowd ranking of the whole grid.",
                pays: "+#{HeadToHead::AwardCompletionBonus::BONUS_AMOUNT} credits per race",
                path: head_to_head_path,
                cta: "Play a round"
            },
            {
                icon: "shield", anchor: "allegiance", title: "Team Allegiance",
                blurb: "Pick a constructor to back for the season. Your name wears its colours everywhere on the site.",
                pays: "Bragging rights",
                path: (signed_in_portfolio ? "#{fantasy_overview_path(current_user.username)}#team-picker" : nil),
                cta: "Pick your team"
            }
        ]
    %>

    <div class="guide-pillars">
        <% pillars.each do |p| %>
            <%= content_tag((p[:path] ? :a : :div), class: "guide-pillar card", href: p[:path]) do %>
                <span class="guide-pillar-icon"><%= ui_icon p[:icon], size: 22 %></span>
                <h2 class="guide-pillar-title"><%= p[:title] %></h2>
                <p class="guide-pillar-blurb"><%= p[:blurb] %></p>
                <span class="guide-pillar-pays"><%= p[:pays] %></span>
                <% if p[:path] %>
                    <span class="guide-pillar-cta"><%= p[:cta] %> <%= ui_icon "arrow_right", size: 13 %></span>
                <% else %>
                    <%= link_to "Read the rules", "##{p[:anchor]}", class: "guide-pillar-cta" %>
                <% end %>
            <% end %>
        <% end %>
    </div>

    <%# ═══════════════════ Market ═══════════════════ %>
    <div class="table-header" id="market"><h3>The Driver Market</h3></div>
    <div class="elo-explanation">
        <p>
            A driver's share price is their Elo rating &divide; <%= FantasyStockPortfolio::PRICE_DIVISOR.to_i %>,
            nudged by how many other players hold them. Elo moves when a driver beats or loses to the
            people they actually raced against &mdash; so the market rewards reading form, not reading a points table.
        </p>

        <div class="elo-worked-example">
            <div class="elo-step-grid">
                <div class="elo-step">
                    <div class="elo-step-pip" style="background: var(--page-accent, #e10600)">1</div>
                    <div class="elo-step-content">
                        <strong>Starting capital</strong>
                        <span>You get <%= number_with_delimiter(Fantasy::CreatePortfolio::STARTING_CAPITAL.to_i) %> credits, once. Everyone starts level.</span>
                    </div>
                </div>
                <div class="elo-step">
                    <div class="elo-step-pip" style="background: var(--page-accent, #e10600)">2</div>
                    <div class="elo-step-content">
                        <strong>Take positions</strong>
                        <span>Long a driver you expect to rise, short one you expect to fall. Up to <%= FantasyStockPortfolio::MAX_POSITIONS %> open at a time.</span>
                    </div>
                </div>
                <div class="elo-step">
                    <div class="elo-step-pip" style="background: var(--page-accent, #e10600)">3</div>
                    <div class="elo-step-content">
                        <strong>The market locks</strong>
                        <span>Trading closes one minute before the race starts. No trading on what you already saw happen.</span>
                    </div>
                </div>
                <div class="elo-step">
                    <div class="elo-step-pip" style="background: var(--page-accent, #e10600)">4</div>
                    <div class="elo-step-content">
                        <strong>Settlement</strong>
                        <span>Elos update, dividends pay out, borrow fees come off, and your portfolio is revalued.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="guide-split">
            <div class="guide-side guide-side-long">
                <span class="guide-side-tag"><%= ui_icon "trend_up", size: 14 %> Long</span>
                <p>
                    You profit when the driver's Elo <strong>rises</strong>. Longs also collect
                    <strong>dividends</strong> for every top-10 finish, scaled by how weak the car is &mdash;
                    a points finish in a slow car pays far more than the same result in a fast one.
                </p>
            </div>
            <div class="guide-side guide-side-short">
                <span class="guide-side-tag"><%= ui_icon "trend_down", size: 14 %> Short</span>
                <p>
                    You profit when the driver's Elo <strong>falls</strong>. Shorts lock up collateral,
                    pay a <%= (Fantasy::Stock::SettleRace::BORROW_FEE_RATE * 100).round(2) %>% borrow fee
                    every race you hold them, and are auto-liquidated if losses reach 2&times; the entry price.
                    Cheap to be right, expensive to be stubborn.
                </p>
            </div>
        </div>
    </div>

    <%# ═══════════════════ Race Picks ═══════════════════ %>
    <div class="table-header" id="picks"><h3>Race Picks</h3></div>
    <div class="elo-explanation">
        <p>
            Before each race you order the drivers you think will finish in the top
            <%= Fantasy::ScoreRacePicks::SCORING_TOP_N %>. Picks lock at lights out and are scored
            on <em>how close</em> each call was, so a near miss is still worth something.
        </p>

        <div class="elo-results-grid elo-results-grid-3 guide-picks-grid">
            <% [[0, "Exact position"], [1, "One place out"], [2, "Two places out"], [3, "Three places out"]].each do |distance, label| %>
                <div class="elo-result-card">
                    <div class="elo-result-label"><%= label %></div>
                    <div class="elo-result-value"><%= Fantasy::ScoreRacePicks::POINTS_BY_DISTANCE[distance] %> pts</div>
                </div>
            <% end %>
            <div class="elo-result-card">
                <div class="elo-result-label">Perfect podium</div>
                <div class="elo-result-value">+<%= Fantasy::ScoreRacePicks::PERFECT_PODIUM_BONUS %> pts</div>
                <span class="elo-result-sub">All three, in the right order</span>
            </div>
            <div class="elo-result-card">
                <div class="elo-result-label">Four or more out</div>
                <div class="elo-result-value">0 pts</div>
                <span class="elo-result-sub">No points below that</span>
            </div>
        </div>

        <p class="guide-note">
            <%= ui_icon "info", size: 14 %>
            <span>No account yet? You can still build a set of picks &mdash; they're held for you and saved to your portfolio the moment you sign up.</span>
        </p>
    </div>

    <%# ═══════════════════ Driver Cards ═══════════════════ %>
    <div class="table-header" id="cards"><h3>Driver Cards</h3></div>
    <div class="elo-explanation">
        <p>
            Get a position <strong>exactly</strong> right and you mint a collectible card for that driver.
            Nothing else earns one &mdash; close doesn't count here. How hard the call was decides the tier.
        </p>

        <div class="guide-tier-ladder">
            <% [
                 ["bronze",    "P4–P10 called exactly", "The bread and butter"],
                 ["silver",    "P2 or P3 called exactly",    "Podium precision"],
                 ["gold",      "The winner called exactly",  "You saw it coming"],
                 ["platinum",  "A winner who started outside the top #{DriverCards::ResolveTier::UPSET_GRID_THRESHOLD}", "You saw the upset coming"],
                 ["legendary", "A #{(DriverCards::ResolveTier::BUMP_PROBABILITY * 100).round}% roll on a platinum", "Very few of these exist"]
               ].each do |tier, how, note| %>
                <div class="guide-tier guide-tier-<%= tier %>">
                    <span class="guide-tier-name"><%= tier %></span>
                    <span class="guide-tier-how"><%= how %></span>
                    <span class="guide-tier-note"><%= note %></span>
                </div>
            <% end %>
        </div>

        <p class="guide-note">
            <%= ui_icon "card", size: 14 %>
            <span>
                Every card also rolls a <%= (DriverCards::ResolveTier::BUMP_PROBABILITY * 100).round %>% chance
                of bumping one tier higher. And <%= DriverCards::Combine::REQUIRED_COUNT %> duplicates of the same
                driver at the same tier can be combined into a single card one tier up.
            </span>
        </p>
    </div>

    <%# ═══════════════════ Head to Head ═══════════════════ %>
    <div class="table-header" id="h2h"><h3>Head-to-Head</h3></div>
    <div class="elo-explanation">
        <p>
            A run of one-question matchups: given two drivers, which do you rate higher? It takes a couple
            of minutes, needs no account, and pays
            <strong>+<%= HeadToHead::AwardCompletionBonus::BONUS_AMOUNT %> credits</strong> once per race weekend
            if you have a portfolio.
        </p>
        <p>
            Your answers aren't just a game. They feed the
            <%= link_to "crowd ranking", head_to_head_results_path, class: "guide-inline-link" %> &mdash;
            what the site's players collectively think of the grid, which is worth comparing against
            <%= link_to "what Elo thinks", current_active_elo_drivers_path, class: "guide-inline-link" %>.
            The two disagree more often than you'd expect.
        </p>
    </div>

    <%# ═══════════════════ Allegiance + scoring ═══════════════════ %>
    <div class="table-header" id="allegiance"><h3>Allegiance &amp; the leaderboard</h3></div>
    <div class="elo-explanation">
        <p>
            Pick one constructor to back for the season and your name carries its colour on every
            leaderboard and profile. It's locked until mid-season, so choose like you mean it.
        </p>
        <p>
            The <%= link_to "leaderboard", combined_leaderboard_path, class: "guide-inline-link" %> ranks
            everyone by <strong>net value</strong> &mdash; what you've made or lost against the same
            starting capital everyone else got. Achievements are checked automatically after every race
            across three tiers:
            <span class="guide-tier-word guide-tier-word-bronze">bronze</span>,
            <span class="guide-tier-word guide-tier-word-silver">silver</span> and
            <span class="guide-tier-word guide-tier-word-gold">gold</span>.
        </p>
    </div>

    <%# ═══════════════════ CTA ═══════════════════ %>
    <div class="guide-cta card">
        <div class="guide-cta-text">
            <h2>Ready to play?</h2>
            <p>The season's already running. You start with the same <%= number_with_delimiter(Fantasy::CreatePortfolio::STARTING_CAPITAL.to_i) %> credits as everyone else.</p>
        </div>
        <div class="guide-cta-actions">
            <% if user_signed_in? %>
                <% if signed_in_portfolio %>
                    <%= link_to fantasy_overview_path(current_user.username), class: "fantasy-btn fantasy-btn-primary" do %>
                        <%= ui_icon "briefcase" %> My Portfolio
                    <% end %>
                <% else %>
                    <%= link_to new_fantasy_portfolio_path, class: "fantasy-btn fantasy-btn-primary" do %>
                        <%= ui_icon "plus" %> Start Trading
                    <% end %>
                <% end %>
            <% else %>
                <%= link_to new_user_session_path, class: "fantasy-btn fantasy-btn-primary" do %>
                    <%= ui_icon "flag" %> Sign in to play
                <% end %>
            <% end %>
            <%= link_to combined_leaderboard_path, class: "fantasy-btn fantasy-btn-outline" do %>
                <%= ui_icon "podium" %> Leaderboard
            <% end %>
        </div>
    </div>
</div>
