<%
  # Marketing hero for signed-out visitors on the homepage.
  # Uses site-wide stats loaded on the homepage to prove scale.
  drivers_count = @active_driver_count || Driver.count
  races_count   = @total_races_tracked || @total_races || Race.count
%>
<div class="loggedout-hero">
  <div class="loggedout-hero-bg"></div>
  <div class="loggedout-hero-content">
    <span class="loggedout-hero-eyebrow">Formula 1 · Elo Ratings · Fantasy · Picks</span>
    <h1 class="loggedout-hero-title">
      Rate every F1 driver.<br>
      Every race. Since 1950.
    </h1>
    <p class="loggedout-hero-sub">
      Chess-style Elo ratings that cross eras. Predict the podium. Play the market.
      Pick your rivals in head-to-head — no signup required to start.
    </p>
    <div class="loggedout-hero-ctas">
      <%= link_to new_user_registration_path, class: "loggedout-hero-cta loggedout-hero-cta-primary" do %>
        <i class="fa-solid fa-flag-checkered"></i> Create an account
      <% end %>
      <%= link_to head_to_head_path, class: "loggedout-hero-cta loggedout-hero-cta-outline" do %>
        <i class="fa-solid fa-people-arrows"></i> Try Head-to-Head
      <% end %>
    </div>
    <div class="loggedout-hero-proof">
      <span class="loggedout-hero-proof-item">
        <strong><%= number_with_delimiter(drivers_count) %></strong>
        <span>drivers</span>
      </span>
      <span class="loggedout-hero-proof-dot">·</span>
      <span class="loggedout-hero-proof-item">
        <strong><%= number_with_delimiter(races_count) %></strong>
        <span>races</span>
      </span>
      <span class="loggedout-hero-proof-dot">·</span>
      <span class="loggedout-hero-proof-item">
        <strong>1950</strong>
        <span>to today</span>
      </span>
    </div>
  </div>
</div>
