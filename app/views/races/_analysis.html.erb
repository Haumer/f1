<section class="race-analysis" id="race-analysis" aria-labelledby="race-analysis-title">
  <header class="race-analysis-heading">
    <div>
      <span class="race-analysis-eyebrow">The race, in perspective</span>
      <h2 id="race-analysis-title">Race debrief</h2>
      <p>What the result changed. Where it departed from the ratings.</p>
    </div>
    <span class="race-analysis-round">R<%= analysis.race.round.to_s.rjust(2, "0") %><small><%= analysis.race.year %></small></span>
  </header>

  <div class="race-analysis-coverage" aria-label="Available analysis data">
    <span><strong><%= analysis.coverage[:results] %></strong> stored results</span>
    <span><strong><%= analysis.coverage[:elo] %>/<%= analysis.coverage[:results] %></strong> Elo snapshots</span>
    <span><strong><%= analysis.coverage[:grid] %>/<%= analysis.coverage[:results] %></strong> numbered grid slots</span>
    <span><strong><%= analysis.coverage[:qualifying] %>/<%= analysis.coverage[:results] %></strong> qualifying results</span>
  </div>

  <% if analysis.highlights.any? %>
    <div class="race-analysis-highlights">
      <% analysis.highlights.each do |highlight| %>
        <article class="race-analysis-highlight race-analysis-<%= highlight[:tone] %>">
          <span class="race-analysis-label"><%= highlight[:label] %></span>
          <div class="race-analysis-value"><%= analysis_signed(highlight[:value], precision: highlight[:unit] == "Elo" ? 1 : 0) %><small><%= highlight[:unit] %></small></div>
          <h3><%= link_to highlight[:row].driver.surname, driver_path(highlight[:row].driver) %></h3>
          <p><%= highlight[:detail] %></p>
        </article>
      <% end %>
    </div>
  <% end %>

  <div class="race-analysis-columns">
    <section class="race-analysis-panel" aria-labelledby="race-analysis-order-title">
      <div class="race-analysis-panel-heading">
        <span class="race-analysis-label">Form meets the result</span>
        <h3 id="race-analysis-order-title">Elo order vs finish</h3>
        <p>The largest differences among classified finishers. An Elo seed is a driver's pre-race rating rank in this field—not a predicted finishing position.</p>
      </div>
      <% if analysis.seeded? && analysis.comparison_rows.any? %>
        <div class="race-analysis-legend" aria-hidden="true"><span>○ Elo seed</span><span>● Finish</span><span>Better ← → Worse</span></div>
        <table class="race-analysis-comparison">
          <caption class="visually-hidden">Up to eight largest differences from pre-race Elo order; positive changes mean finishing ahead of the seed.</caption>
          <thead><tr><th scope="col">Driver</th><th scope="col">Seed</th><th scope="col" class="race-analysis-lane-cell"><span class="visually-hidden">Position change chart</span></th><th scope="col">Finish</th><th scope="col">Change</th></tr></thead>
          <tbody>
            <% analysis.comparison_rows.each do |row| %>
              <tr class="race-analysis-<%= analysis_tone(row.seed_change) %>">
                <th scope="row"><%= link_to row.driver.surname, driver_path(row.driver) %></th>
                <td><%= analysis_seed(row.seed) %></td>
                <td class="race-analysis-lane-cell"><div class="race-analysis-lane" style="<%= analysis_lane_style(row, analysis.rows.size) %>" aria-hidden="true"><span class="race-analysis-trace"></span><span class="race-analysis-seed"></span><span class="race-analysis-finish"></span></div></td>
                <td><%= row.display_position %></td>
                <td class="race-analysis-change"><%= analysis_signed(row.seed_change, precision: row.seed_change == row.seed_change.to_i ? 0 : 1) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="race-analysis-empty">A comparison needs a pre-race Elo snapshot and result order for every stored entrant, plus a classified finisher. Missing ratings are not treated as zero.</p>
      <% end %>
      <% non_finishers = analysis.rows.reject(&:classified?) %>
      <% if non_finishers.any? %>
        <div class="race-analysis-statuses">
          <span class="race-analysis-label">Outside finishing comparisons</span>
          <% non_finishers.each do |row| %>
            <span title="<%= row.result.status&.status_type %>"><%= row.driver.surname %> <strong><%= row.display_position %></strong></span>
          <% end %>
          <p>Retirements and other non-finishes still affect Elo. Their statuses are not treated as places lost here.</p>
        </div>
      <% end %>
    </section>

    <section class="race-analysis-panel" aria-labelledby="race-analysis-championship-title">
      <div class="race-analysis-panel-heading">
        <span class="race-analysis-label">The bigger picture</span>
        <h3 id="race-analysis-championship-title">Championship after this round</h3>
        <p>Top five in the stored standings. Points include sprint results where applicable.</p>
      </div>
      <% if analysis.championship.any? %>
        <ol class="race-analysis-standings">
          <% analysis.championship.each do |entry| %>
            <% standing = entry[:standing] %>
            <li>
              <span class="race-analysis-standing-position"><%= standing.position %></span>
              <%= link_to standing.driver.surname, driver_path(standing.driver) %>
              <strong><%= format_points(standing.points) %><small>pts</small></strong>
              <span class="race-analysis-standing-movement race-analysis-<%= analysis_tone(entry[:movement]) %>" title="Positions gained since the previous round"><%= analysis_signed(entry[:movement]) %></span>
            </li>
          <% end %>
        </ol>
        <p class="race-analysis-footnote"><%= analysis.previous_round ? "Movement since round #{analysis.previous_round.round}. A dash means the earlier standing is unavailable." : "Opening round: no earlier standings in this season to compare." %></p>
      <% else %>
        <p class="race-analysis-empty">Championship standings are not stored for this round.</p>
      <% end %>
      <%= link_to "Explore the season →", season_path(analysis.race.season), class: "race-analysis-text-link" %>
    </section>
  </div>

  <% if analysis.teammates.any? %>
    <section class="race-analysis-panel race-analysis-teams" aria-labelledby="race-analysis-teams-title">
      <div class="race-analysis-panel-heading">
        <span class="race-analysis-label">Across the garage</span>
        <h3 id="race-analysis-teams-title">Teammate results</h3>
        <p>Two-driver constructor entries from this race. A result comparison, not an adjustment for strategy or reliability.</p>
      </div>
      <div class="race-analysis-team-grid">
        <% analysis.teammates.each do |team| %>
          <article class="race-analysis-team" style="--team-color: <%= constructor_color(team[:constructor]) %>">
            <h4><%= link_to team[:constructor].name, constructor_path(team[:constructor]) %></h4>
            <% team[:rows].each do |row| %>
              <div class="race-analysis-team-result"><%= link_to row.driver.surname, driver_path(row.driver) %><strong title="<%= row.result.status&.status_type %>"><%= row.display_position %></strong><span class="race-analysis-<%= analysis_tone(row.elo_change) %>"><%= analysis_signed(row.elo_change, precision: 1) %> Elo</span></div>
            <% end %>
            <p><%= team[:gap] ? "#{pluralize(team[:gap], 'place')} apart at the finish." : "Non-finish recorded; no finishing gap comparison." %></p>
            <% if (qualifying = team[:qualifying]) %>
              <p class="race-analysis-quali"><%= qualifying[:segment] %> · <%= qualifying[:gap].zero? ? "Equal recorded times" : "#{qualifying[:faster].driver.surname} #{number_with_precision(qualifying[:gap], precision: 3)}s faster" %></p>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <details class="race-analysis-method" id="race-analysis-method">
    <summary>What this analysis can—and cannot—tell you</summary>
    <div>
      <p>This debrief is calculated from the results and rating snapshots stored for this race. Source corrections are reflected on the next page load; it is not a separately reviewed race report.</p>
      <p>Elo uses the result order, including retirements. It does not isolate driver skill from the car, reliability, penalties or strategy. Elo seed comparisons use pre-race ratings, never today's ratings. Equal ratings share the midpoint of their rank range (for example, tied first and second become seed 1.5).</p>
      <p>Grid gains use numbered starting slots and classified finishes only. Zero or missing grid values are excluded; a position gained is not necessarily an overtake. Qualifying gaps use the latest segment both teammates have a valid time for, never Q1 against Q3.</p>
      <p>Lap-by-lap pace, tyre stints, pit-stop execution and safety-car effects are not available in this report. Missing data is omitted, not inferred.</p>
      <%= link_to "Read the Elo methodology →", elo_path, class: "race-analysis-text-link" %>
    </div>
  </details>

  <aside class="race-analysis-fantasy" aria-label="Fantasy race recap">
    <div>
      <span class="race-analysis-label">Your read of the grid</span>
      <% if analysis.fantasy[:players].positive? %>
        <h3><%= analysis.fantasy[:best] %> points was the score to beat.</h3>
        <p><%= pluralize(analysis.fantasy[:players], "scored entry") %> · <%= number_with_precision(analysis.fantasy[:average], precision: 1) %> average pick score this race.</p>
      <% else %>
        <h3>What would you have called differently?</h3>
        <p>Put your race reading to work with free picks and driver trading.</p>
      <% end %>
    </div>
    <%= link_to "Explore Fantasy →", fantasy_home_path, class: "race-analysis-fantasy-link" %>
  </aside>
</section>
