<% content_for(:title) { "Your Picks — #{@race.circuit.name}" } %>
<% content_for(:description) { "Make your race predictions for the #{@race.circuit.name} and see how your picks compare." } %>
<% content_for(:main_container_class) { "picks-editor-container" } %>
<% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="page-container picks-editor-page">
    <div class="picks-header">
        <div>
            <%# Without this the page is a cul-de-sac — it had no in-content links at all. %>
            <%= link_to(user_signed_in? ? fantasy_overview_path(current_user.username) : fantasy_guide_path,
                        class: "picks-compact-edit") do %>
                <i class="fa-solid fa-arrow-left"></i>
                <%= user_signed_in? ? "Back to portfolio" : "How fantasy works" %>
            <% end %>
            <h2><i class="fa-solid fa-hand-pointer" style="opacity:0.5; font-size:18px"></i> Your Picks</h2>
            <p class="picks-subtitle">
                <%= @race.circuit.name %> · Round <%= @race.round %>
                <% if @race.date %> · <%= @race.date.strftime("%b %d, %Y") %><% end %>
            </p>
        </div>
        <% if @race.starts_at %>
            <div class="picks-deadline">
                <i class="fa-solid fa-clock"></i>
                <%= render "shared/deadline", closes_at: @race.starts_at, label: "Picks lock" %>
            </div>
        <% end %>
    </div>

    <div data-controller="race-picks"
         data-race-picks-total-value="<%= @drivers.size %>"
         data-race-picks-goal-value="<%= @pick_goal %>"
         data-race-picks-storage-key-value="f1elo:picks:<%= current_user&.id || 'guest' %>:<%= @race.id %>"
         data-race-picks-version-value="<%= @race_pick.updated_at&.iso8601(6) %>"
         data-race-picks-saved-value="<%= @race_pick.persisted? %>"
         data-race-picks-closes-at-value="<%= @race.starts_at&.iso8601 %>"
         data-race-picks-open-value="<%= @race.picks_open? && !@race_pick.locked? %>">
        <%# ═══════ Driver Card Grid ═══════ %>
        <div class="picks-toolbar">
            <div class="picks-instruction">
                <span>Tap drivers in finishing order, starting with P1.</span>
                <span class="picks-reward-hint">
                    <%= @scoring_limit ? "Only your top #{@pick_goal} score. Ranking the rest is optional." : "Every predicted position can score." %>
                </span>
            </div>
            <div class="picks-toolbar-right">
                <div class="picks-sort" data-race-picks-target="sortGroup">
                    <button type="button" class="picks-sort-btn active" aria-pressed="true" data-action="click->race-picks#sort" data-sort="form">Form</button>
                    <button type="button" class="picks-sort-btn" aria-pressed="false" data-action="click->race-picks#sort" data-sort="elo">Elo</button>
                    <button type="button" class="picks-sort-btn" aria-pressed="false" data-action="click->race-picks#sort" data-sort="team">Team</button>
                    <button type="button" class="picks-sort-btn" aria-pressed="false" data-action="click->race-picks#sort" data-sort="alpha">A–Z</button>
                </div>
                <button type="button" class="picks-toggle" aria-pressed="false" data-action="click->race-picks#toggleForm" data-race-picks-target="formToggle">
                    <span class="picks-toggle-track">
                        <span class="picks-toggle-thumb"></span>
                    </span>
                    <span class="picks-toggle-label">Recent Form</span>
                </button>
            </div>
        </div>
        <div class="picks-driver-grid" id="pick-drivers" tabindex="-1" aria-label="Choose drivers in finishing order">
            <% @drivers.each do |driver| %>
                <% constructor = @constructors_by_driver[driver.id] %>
                <% color = constructor_color(constructor) %>
                <% results = @recent_results[driver.id] || [] %>
                <% last_pos = results.first&.position_order || 99 %>
                <button type="button" class="picks-driver-card" aria-label="Pick <%= driver.fullname %>" aria-pressed="false"
                     data-race-picks-target="card"
                     data-driver-id="<%= driver.id %>"
                     data-driver-name="<%= driver.fullname %>"
                     data-driver-surname="<%= driver.surname %>"
                     data-driver-team="<%= constructor&.name %>"
                     data-driver-team-color="<%= color %>"
                     data-driver-elo="<%= driver.display_elo.round(0) %>"
                     data-driver-last-pos="<%= last_pos %>"
                     data-action="click->race-picks#place"
                     style="--constructor-color: <%= color %>">
                    <span class="picks-card-header">
                        <% if driver.display_image_url.present? %>
                            <img src="<%= driver.display_image_url %>" alt="<%= driver.fullname %>" class="picks-card-photo" onerror="this.style.display='none'">
                        <% else %>
                            <span class="picks-card-photo picks-card-photo-placeholder">
                                <i class="fa-solid fa-user"></i>
                            </span>
                        <% end %>
                        <span class="picks-card-info">
                            <span class="picks-card-name"><%= driver.surname %></span>
                            <span class="picks-card-team"><%= constructor_logo_or_name(constructor, size: "xs") %></span>
                        </span>
                        <span class="picks-card-elo"><%= driver.display_elo.round(0) %></span>
                    </span>
                    <% if results.any? %>
                        <span class="picks-card-results">
                            <% prev_year = nil %>
                            <% results.first(5).each do |rr| %>
                                <% race_year = rr.race.year.to_s %>
                                <% if race_year != @race.year.to_s && race_year != prev_year %>
                                    <span class="picks-result-season">'<%= race_year[-2..] %></span>
                                <% end %>
                                <% prev_year = race_year %>
                                <% pos = rr.position_order %>
                                <span class="picks-result-badge picks-result-p<%= pos <= 3 ? pos : (pos <= 10 ? 'points' : 'back') %>" title="R<%= rr.race.round %> <%= race_year %>">
                                    <% if rr.status&.status_type&.match?(/Retired|Accident|Collision|Mechanical|Spun/i) %>
                                        DNF
                                    <% else %>
                                        P<%= pos %>
                                    <% end %>
                                </span>
                            <% end %>
                        </span>
                    <% end %>
                    <span class="picks-card-check"><i class="fa-solid fa-check"></i></span>
                </button>
            <% end %>
        </div>

        <div class="picks-goal-ready" data-race-picks-target="goalReady" hidden>
            <span>Your top <%= @pick_goal %> is ready to save.</span>
            <% if @drivers.size > @pick_goal %>
                <button type="button" class="picks-action-btn" data-race-picks-target="optionalBtn" data-action="race-picks#rankRest">Rank the rest (optional)</button>
            <% end %>
        </div>

        <%# ═══════ Picks List ═══════ %>
        <div class="picks-list-section">
            <div class="picks-list-header">
                <h3 id="pick-order" tabindex="-1">
                    <i class="fa-solid fa-list-ol" style="opacity:0.5; font-size:14px"></i>
                    Your Order
                    <span class="picks-counter" data-race-picks-target="counter">0/<%= @pick_goal %></span>
                </h3>
                <div class="picks-list-actions">
                    <button type="button" class="picks-action-btn picks-choose-more" data-action="race-picks#chooseMore">Choose drivers ↑</button>
                    <button type="button" class="picks-action-btn" data-race-picks-target="undoBtn" data-action="race-picks#undo" hidden>Undo</button>
                    <button type="button" class="picks-action-btn" data-race-picks-target="randomiseBtn" data-action="click->race-picks#randomise" hidden>
                        <i class="fa-solid fa-shuffle"></i> Randomise rest
                    </button>
                    <button type="button" class="picks-action-btn picks-action-clear" data-race-picks-target="clearBtn" data-action="click->race-picks#clear" hidden>
                        <i class="fa-solid fa-trash"></i> Clear
                    </button>
                </div>
            </div>

            <p class="picks-order-hint">Drag to reorder, or use the arrow buttons. You can save fewer than <%= @pick_goal %>.</p>
            <p class="picks-empty" data-race-picks-target="empty">Choose a driver above to start with P1.</p>
            <div class="picks-slots" data-race-picks-target="slotList"></div>
        </div>

        <p class="picks-draft-message" data-race-picks-target="message" role="status" aria-live="polite"></p>
        <%# ═══════ Submit ═══════ %>
        <%= form_with url: (current_user ? race_picks_path : stash_race_picks_path), method: (current_user ? :patch : :post), local: true, class: "picks-submit-form", data: { action: "submit->race-picks#submit turbo:submit-end->race-picks#submitEnd" } do %>
                <input type="hidden" name="race_id" value="<%= @race.id %>">
                <input type="hidden" name="picks" value="<%= @race_pick.picks&.to_json || '[]' %>" data-race-picks-target="picksInput">
                <div class="picks-save-summary">
                    <strong data-race-picks-target="summary">Choose your top <%= @pick_goal %></strong>
                    <small data-race-picks-target="saveState">Not saved</small>
                </div>
                <button type="button" class="picks-review-btn picks-action-btn" data-action="race-picks#review">Review</button>
                <button type="submit" class="fantasy-btn fantasy-btn-primary picks-submit-btn" data-race-picks-target="submitBtn" disabled>
                    <%= current_user ? "Save Picks" : "Sign Up to Save Picks" %>
                </button>
        <% end %>
    </div>
</div>
