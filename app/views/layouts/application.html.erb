<!DOCTYPE html>
<html lang="en">
  <% analytics_id = google_analytics_id %>
  <head>
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="theme-color" content="#0a0a0f">
    <meta name="description" content="<%= meta_description %>">
    <link rel="canonical" href="<%= canonical_url %>">

    <%# PWA %>
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="F1 Elo">

    <%# Favicon %>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Open Graph %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="F1 Elo">
    <meta property="og:title" content="<%= social_title %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:image" content="<%= social_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="F1 Elo driver ratings and fantasy Formula 1">
    <meta property="og:url" content="<%= canonical_url %>">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= social_title %>">
    <meta name="twitter:description" content="<%= meta_description %>">
    <meta name="twitter:image" content="<%= social_image_url %>">
    <meta name="twitter:image:alt" content="F1 Elo driver ratings and fantasy Formula 1">

    <% if request.path == root_path %>
      <script type="application/ld+json"><%= raw json_escape(website_structured_data.to_json) %></script>
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      document.addEventListener('turbo:before-visit', () => {
        document.querySelector('.navbar .links')?.classList.remove('open');
      });
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </head>

  <body
    <% if analytics_id %>
      data-controller="analytics-consent"
      data-analytics-consent-measurement-id-value="<%= analytics_id %>"
    <% end %>
    <% if @page_accent %>
      style="--page-accent: <%= @page_accent %>; --page-accent-rgb: <%= hex_to_rgb(@page_accent) %>;"
    <% end %>
  >
    <% if analytics_id %>
      <aside class="analytics-consent"
             data-analytics-consent-target="banner"
             role="dialog"
             aria-labelledby="analytics-consent-title"
             aria-describedby="analytics-consent-description"
             hidden>
        <div>
          <strong id="analytics-consent-title">Optional analytics</strong>
          <p id="analytics-consent-description">
            Google Analytics helps improve F1 Elo. It loads only if you allow it.
            <%= link_to "Details", terms_path(anchor: "cookies") %>
          </p>
        </div>
        <div class="analytics-consent-actions">
          <button type="button" class="analytics-consent-button" data-action="analytics-consent#decline">No thanks</button>
          <button type="button" class="analytics-consent-button analytics-consent-button-primary" data-action="analytics-consent#accept">Allow analytics</button>
        </div>
      </aside>
    <% end %>
    <% if notice.present? %>
      <div class="flash flash-notice" data-controller="flash">
        <span><%= notice %></span>
        <button class="flash-dismiss" data-action="click->flash#dismiss">&times;</button>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="flash flash-alert" data-controller="flash">
        <span><%= alert %></span>
        <button class="flash-dismiss" data-action="click->flash#dismiss">&times;</button>
      </div>
    <% end %>
    <%= render 'components/navbar' %>
    <div class="container py-3">
      <main><%= yield %></main>
    </div>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-brand">
          <span class="font-display footer-logo">F1 ELO</span>
          <span class="footer-tagline">Rating every Formula 1 driver since 1950</span>
        </div>
        <div class="footer-links-grid">
          <div class="footer-col">
            <span class="footer-col-title">Drivers</span>
            <%= link_to "Peak Elo", peak_elo_drivers_path %>
            <%= link_to "Active Elo", current_active_elo_drivers_path %>
            <%= link_to "Compare", compare_drivers_path %>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Racing</span>
            <%= link_to "Seasons", seasons_path %>
            <%= link_to "Circuits", circuits_path %>
            <%= link_to "Constructors", constructors_path %>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Stats</span>
            <%= link_to "Elo Milestones", elo_milestones_path %>
            <%= link_to "Badges", badges_path %>
            <%= link_to "How Elo Works", elo_path %>
            <%= link_to "About", about_path %>
            <%= link_to "Terms", terms_path %>
            <%= link_to "Impressum", impressum_path %>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span class="footer-copy">Not affiliated with Formula 1, FIA, or any team. All trademarks belong to their respective owners.</span>
        <% if analytics_id %>
          <button type="button" class="footer-privacy" data-action="analytics-consent#open">Privacy settings</button>
        <% end %>
        <a class="footer-build"
           href="<%= BuildInfo.commit_url %>"
           rel="noopener"
           target="_blank"
           title="<%= BuildInfo.title %>">
          <i class="fa-solid fa-code-commit"></i>
          <span><%= BuildInfo.label %></span>
        </a>
      </div>
    </footer>
  </body>
</html>
